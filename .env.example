# Required: Google OAuth and authenticated sessions
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# hydradb for deployment; local is for development only (not persistent on Vercel)
KYNTHERA_STORE=local
HYDRADB_BOLT_URL=bolt://127.0.0.1:7687
HYDRADB_DATABASE=default
HYDRADB_USERNAME=neo4j
HYDRADB_PASSWORD=

# Optional: connect Vercel to a HydraDB HTTPS endpoint (takes precedence over Bolt)
# For a hackathon preview, can be a temporary Cloudflare Tunnel URL.
HYDRADB_HTTP_URL=
HYDRADB_AUTH_TOKEN=
HYDRADB_NAMESPACE=default
HYDRADB_CELL_ID=cell-0
